# Production / Docker environment. Copy to server/.env for local compose
# (docker-compose/docker-compose.yml), or to /opt/sbg-website/.env on the VPS
# next to docker-compose.prod.yml (CI copies that file from docker-compose/).

DATABASE_URL=
JWT_SECRET=
NODE_ENV=production
PORT=3005
CORS_ORIGIN=https://sbg.dau.ac.in

# Optional: bind published port. Production compose defaults to 127.0.0.1:3005.
# HOST_PORT=127.0.0.1:3005

# SMTP - Password Reset
PASSWORD_SMTP_HOST=smtp.gmail.com
PASSWORD_SMTP_PORT=587
PASSWORD_SMTP_USER=
PASSWORD_SMTP_PASS=
PASSWORD_MAIL=

# SMTP - Booking Approval
APPROVAL_SMTP_HOST=smtp.gmail.com
APPROVAL_SMTP_PORT=587
APPROVAL_SMTP_USER=
APPROVAL_SMTP_PASS=
APPROVAL_MAIL=

# SMTP - Event Reminder
REMINDER_SMTP_HOST=smtp.gmail.com
REMINDER_SMTP_PORT=587
REMINDER_SMTP_USER=
REMINDER_SMTP_PASS=
EVENT_REMINDER_MAIL=
